# İki bağlantı bilerek ayrıdır:
# 1) MIGRATE_DATABASE_URL: şema sahibi/süper kullanıcı — sadece migration + seed.
# 2) DATABASE_URL: uygulama rolü (umay_app) — RLS bu role uygulanır.
#    Süper kullanıcı RLS'i BYPASS eder; uygulama asla süper kullanıcıyla bağlanmaz.
MIGRATE_DATABASE_URL=postgresql://postgres:SIFRE@localhost:5440/umay_dev
DATABASE_URL=postgresql://umay_app:umay_app_local@localhost:5440/umay_dev
APP_DB_PASSWORD=umay_app_local

PORT=3100
NODE_ENV=development
SESSION_SECRET=dev-only-change-me
